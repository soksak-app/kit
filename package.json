{
  "name": "@soksak/kit",
  "version": "0.0.14",
  "private": true,
  "description": "Kit: the commit message check, the document check, the event source check, the release gate and the term list that every soksak repository runs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-app/kit.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "sok-check": "./check.js"
  },
  "exports": {
    "./check": "./check.js",
    "./checklist": "./checklist.js",
    "./docs": "./docs.js",
    "./events": "./events.js",
    "./package.json": "./package.json",
    "./terms.json": "./terms.json"
  },
  "files": [
    "check.js",
    "checklist.js",
    "commands.js",
    "commits.js",
    "docs.js",
    "event-rules.json",
    "events.js",
    "release.js",
    "terms.json"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "smol-toml": "1.9.1"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec --test-timeout=60000 test/"
  }
}
