{
  "name": "@soksak/kit",
  "version": "0.0.11",
  "private": true,
  "description": "Kit: the commit message check, the record check, the census check, the release gate and the term list that every soksak repository runs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-app/kit.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "soksak-check": "./check.js"
  },
  "exports": {
    "./check": "./check.js",
    "./checklist": "./checklist.js",
    "./records": "./records.js",
    "./census": "./census.js",
    "./terms.json": "./terms.json",
    "./package.json": "./package.json"
  },
  "files": [
    "census-rules.json",
    "census.js",
    "check.js",
    "checklist.js",
    "commits.js",
    "records.js",
    "release.js",
    "terms.json"
  ],
  "dependencies": {
    "ajv": "8.20.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec --test-timeout=60000 test/"
  }
}
