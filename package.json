  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-app/kit-records.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "soksak-commits": "./commits-check.js",
    "soksak-records": "./records-check.js",
    "soksak-release-gate": "./release-gate.js"
  },
  "exports": {
    "./checklist": "./checklist.js",
    "./records-check": "./records-check.js",
    "./release-gate": "./release-gate.js",
    "./terms.json": "./terms.json",
    "./package.json": "./package.json"
  },
  "files": [
    "checklist.js",
    "commits-check.js",
    "records-check.js",
    "release-gate.js",
    "terms.json"
